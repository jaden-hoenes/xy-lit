{
  "name": "@xy-lit/ui",
  "version": "0.1.0",
  "description": "Ready-made nodes, edges and panels for XY Lit flows: node cards, schema and shape nodes, zoom controls, node search and devtools.",
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "ui-components",
    "flow",
    "node-editor",
    "diagram",
    "xy-lit"
  ],
  "author": "Jaden Hoenes",
  "license": "MIT",
  "homepage": "https://jaden-hoenes.github.io/xy-lit/guide/ui-components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaden-hoenes/xy-lit.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/jaden-hoenes/xy-lit/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define.js": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "custom-elements.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "./dist/define.js"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "manifest": "cem analyze --litelement --globs 'src/**/*.ts' --outdir . --config ../../config/cem.mjs",
    "prepack": "node ../../scripts/copy-notices.mjs && pnpm manifest"
  },
  "dependencies": {
    "@xy-lit/store": "workspace:*",
    "@xy-lit/flow": "workspace:*",
    "lit": "^3.3.3",
    "@lit/context": "^1.1.6"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0"
  },
  "customElements": "custom-elements.json",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
