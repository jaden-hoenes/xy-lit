{
  "name": "@xy-lit/flow",
  "version": "0.0.0",
  "description": "Lit web components for node-based editors and diagrams: a port of React Flow on @xyflow/system. Use from plain HTML or any framework.",
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "flow",
    "graph",
    "node-editor",
    "diagram",
    "workflow",
    "react-flow",
    "xyflow",
    "xy-lit"
  ],
  "author": "Jaden Hoenes",
  "license": "MIT",
  "homepage": "https://jaden-hoenes.github.io/xy-lit/guide/getting-started",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaden-hoenes/xy-lit.git",
    "directory": "packages/flow"
  },
  "bugs": {
    "url": "https://github.com/jaden-hoenes/xy-lit/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define.js": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "custom-elements.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "./dist/define.js"
  ],
  "scripts": {
    "build": "pnpm gen:styles && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "gen:styles": "node scripts/gen-styles.mjs",
    "manifest": "cem analyze --litelement --globs 'src/**/*.ts' --outdir . --config ../../config/cem.mjs",
    "prepack": "node ../../scripts/copy-notices.mjs && pnpm manifest"
  },
  "dependencies": {
    "@xy-lit/store": "workspace:*",
    "lit": "^3.3.3",
    "@lit/context": "^1.1.6"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "postcss": "^8.5.30",
    "postcss-nested": "^8.0.1",
    "postcss-rename": "^0.8.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
