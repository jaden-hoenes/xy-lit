{
  "name": "@xy-lit/pro",
  "version": "0.1.0",
  "description": "Editing features for XY Lit flows: undo/redo, clipboard, helper lines, auto layout, animated positions, expand/collapse and grouping.",
  "keywords": [
    "undo-redo",
    "clipboard",
    "auto-layout",
    "dagre",
    "elk",
    "web-components",
    "lit",
    "flow",
    "node-editor",
    "diagram",
    "xy-lit"
  ],
  "author": "Jaden Hoenes",
  "license": "MIT",
  "homepage": "https://jaden-hoenes.github.io/xy-lit/guide/pro-features",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaden-hoenes/xy-lit.git",
    "directory": "packages/pro"
  },
  "bugs": {
    "url": "https://github.com/jaden-hoenes/xy-lit/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define.js": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "./dist/define.js"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "prepack": "node ../../scripts/copy-notices.mjs"
  },
  "dependencies": {
    "@xy-lit/store": "workspace:*",
    "@xy-lit/flow": "workspace:*",
    "lit": "^3.3.3",
    "rbush": "^4.0.1"
  },
  "peerDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "elkjs": "^0.12.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2"
  },
  "peerDependenciesMeta": {
    "@dagrejs/dagre": {
      "optional": true
    },
    "elkjs": {
      "optional": true
    },
    "d3-force": {
      "optional": true
    },
    "d3-hierarchy": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "elkjs": "^0.12.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/rbush": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
