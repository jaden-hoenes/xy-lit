      "@xy-lit/collab-yjs/define.js": ["./packages/collab-yjs/src/define.ts"],
      "@xy-lit/collab-yjs": ["./packages/collab-yjs/src/index.ts"],
      "@xy-lit/pro/define.js": ["./packages/pro/src/define.ts"],
