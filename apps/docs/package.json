{
  "name": "@xy-lit/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:api": "node scripts/gen-api.mjs",
    "predev": "node scripts/gen-api.mjs",
    "dev": "vitepress dev --port ${DOCS_PORT:-5176}",
    "prebuild": "node scripts/gen-api.mjs",
    "build": "vitepress build",
    "preview": "vitepress preview --port ${DOCS_PORT:-5176}",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:snippets": "node scripts/check-snippets.mjs",
    "test": "pnpm build && pnpm check:snippets && playwright test"
  },
  "dependencies": {
    "@xy-lit/store": "workspace:*",
    "@xy-lit/flow": "workspace:*",
    "@xy-lit/collab-yjs": "workspace:*",
    "@xy-lit/pro": "workspace:*",
    "@xy-lit/ui": "workspace:*",
    "lit": "^3.3.3",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "@fontsource-variable/inter": "^5.3.0"
  }
}
